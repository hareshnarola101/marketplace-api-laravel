APP_NAME="Marketplace API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches the "db" service in docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=marketplace
DB_USERNAME=marketplace
DB_PASSWORD=secret

# Token-authenticated API: no server-side sessions needed.
SESSION_DRIVER=array

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails (vendor order notifications) are written to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@marketplace.test"
MAIL_FROM_NAME="${APP_NAME}"

MARKETPLACE_CURRENCY=USD
MARKETPLACE_COMMISSION_BPS=1000

# "fake" works offline. Switch to "stripe" and fill in test-mode keys to use Stripe.
PAYMENT_GATEWAY=fake
FAKE_WEBHOOK_SECRET=local-fake-webhook-secret
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
